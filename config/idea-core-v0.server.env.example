# IDEA Engineering Core v0 — Ubuntu development-server template.
# Copy to an ignored server-local file after inspecting the actual host.
# Do not commit passwords, tokens, server-local paths or the filled copy.
# A later accepted deployment needs its own reviewed configuration and qualification.

IDEA_ENVIRONMENT=Development

# Initial one-developer access uses SSH forwarding to loopback-bound services.
IDEA_SERVER_BIND_ADDRESS=127.0.0.1
IDEA_SERVER_PORT=8080
IDEA_SERVER_BASE_URL=http://127.0.0.1:8080
IDEA_WEB_DEV_SERVER_URL=http://127.0.0.1:5173

# Native PostgreSQL 18 on this Ubuntu host; exact package version is qualified before installation.
IDEA_DATABASE_HOST=127.0.0.1
IDEA_DATABASE_PORT=5432
IDEA_DATABASE_NAME=idea_ddm_dev
IDEA_DATABASE_APP_USER=idea_ddm_app
IDEA_DATABASE_APP_PASSWORD=REPLACE_IN_IGNORED_SERVER_FILE
IDEA_DATABASE_MIGRATION_USER=idea_ddm_migrator
IDEA_DATABASE_MIGRATION_PASSWORD=REPLACE_IN_IGNORED_SERVER_FILE

# One filesystem-backed Vault location for Core v0 development.
# These IDs are logical; application code must not construct the physical path.
IDEA_VAULT_ID=VAULT-01
IDEA_VAULT_LOCATION_ID=SERVER-DEV-01
IDEA_VAULT_ADAPTER=FILESYSTEM
IDEA_VAULT_ROOT=/srv/idea/artifacts/vault-01
