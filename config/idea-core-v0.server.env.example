# IDEA Engineering Core v0 — Ubuntu development-server template.
# Copy to config/idea-core-v0.server.local on the Ubuntu host.
# That filled file is ignored by Git. Never put working credentials in this example.
# This template is only for the one-developer PH1 development host, not a deployment profile.

IDEA_ENVIRONMENT=Development

# Initial one-developer access uses SSH forwarding to loopback-bound services.
# Validation: Environment must be Development. Bind address must be a valid local IPv4/IPv6
# address; keep 127.0.0.1 while using SSH forwarding. Port values must be decimal 1..65535.
IDEA_SERVER_BIND_ADDRESS=127.0.0.1
IDEA_SERVER_PORT=8080
IDEA_SERVER_BASE_URL=http://127.0.0.1:8080
IDEA_WEB_DEV_SERVER_URL=http://127.0.0.1:5173

# Native PostgreSQL 18 on this Ubuntu host; exact package version is qualified before installation.
# Validation: host must be reachable from this server; port is decimal 1..65535; database and
# role names must match the provisioned instance. App and migration roles must remain distinct.
# Passwords must be non-empty, different, and supplied only in the ignored local file or a
# protected environment/secret store. Do not log them or place them in a command line.
IDEA_DATABASE_HOST=127.0.0.1
IDEA_DATABASE_PORT=5432
IDEA_DATABASE_NAME=idea_ddm_dev
IDEA_DATABASE_APP_USER=idea_ddm_app
IDEA_DATABASE_APP_PASSWORD=REPLACE_IN_IGNORED_SERVER_FILE
IDEA_DATABASE_MIGRATION_USER=idea_ddm_migrator
IDEA_DATABASE_MIGRATION_PASSWORD=REPLACE_IN_IGNORED_SERVER_FILE

# One filesystem-backed Vault location for Core v0 development.
# Validation: IDs are stable logical identifiers and must not be derived from host/path.
# Adapter must be FILESYSTEM for PH1. Root must be an absolute, service-owned private directory;
# application code must not construct a physical path from IDs. Configure only one Vault here.
# A later multi-Vault increment may add endpoints without changing Artifact/Vault/Location identity.
IDEA_VAULT_ID=VAULT-01
IDEA_VAULT_LOCATION_ID=SERVER-DEV-01
IDEA_VAULT_ADAPTER=FILESYSTEM
IDEA_VAULT_ROOT=/srv/idea/artifacts/vault-01
