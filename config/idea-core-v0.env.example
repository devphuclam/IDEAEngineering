# IDEA Engineering Core v0 — Windows client development template.
# The Java Server, Web build, PostgreSQL and Vault run on the Ubuntu development server.
# Copy to config/.env.idea-core-v0.local only when a Windows client needs local settings.
# This tracked file must not contain credentials or a physical Vault path.

IDEA_ENVIRONMENT=DevelopmentClient

# These loopback URLs work when Ubuntu services are reached through SSH port forwarding.
IDEA_SERVER_BASE_URL=http://127.0.0.1:8080
IDEA_WEB_DEV_SERVER_URL=http://127.0.0.1:5173
