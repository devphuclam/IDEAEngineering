<Window x:Class="Idea.Q15.OptionA.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="IDEA Engineering Q-15 — Option A" Width="1440" Height="900"
        MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
    <wv2:WebView2 x:Name="WebView" Grid.Row="0" />
    <Border Grid.Row="1" Background="#102A52" Padding="8,3">
      <TextBlock x:Name="ShellStatus" Foreground="White" FontSize="11" Text="Starting narrow shell…" />
    </Border>
  </Grid>
</Window>
